import tkinter as tk
from tkinter import ttk, messagebox
import json

# Файл для хранения данных
DATA_FILE = 'movies.json'

# Основной класс приложения
class MovieLibraryApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Movie Library")
        
        # Инициализация данных
        self.movies = []
        self.load_data()
        
        self.create_widgets()
        self.populate_table()
    
    def create_widgets(self):
        # Поля для ввода
        frame = tk.Frame(self.root)
        frame.pack(padx=10, pady=10)
        
        tk.Label(frame, text="Название").grid(row=0, column=0)
        self.title_entry = tk.Entry(frame)
        self.title_entry.grid(row=0, column=1)
        
        tk.Label(frame, text="Жанр").grid(row=0, column=2)
        self.genre_entry = tk.Entry(frame)
        self.genre_entry.grid(row=0, column=3)
        
        tk.Label(frame, text="Год выпуска").grid(row=1, column=0)
        self.year_entry = tk.Entry(frame)
        self.year_entry.grid(row=1, column=1)
        
        tk.Label(frame, text="Рейтинг").grid(row=1, column=2)
        self.rating_entry = tk.Entry(frame)
        self.rating_entry.grid(row=1, column=3)
        
        # Кнопка для добавления фильма
        add_btn = tk.Button(self.root, text="Добавить фильм", command=self.add_movie)
        add_btn.pack(pady=5)
        
        # Фильтры
        filter_frame = tk.Frame(self.root)
        filter_frame.pack(padx=10, pady=5)
        
        tk.Label(filter_frame, text="Фильтр по жанру").grid(row=0, column=0)
        self.genre_filter = ttk.Combobox(filter_frame, values=["Все"])
        self.genre_filter.current(0)
        self.genre_filter.bind("<<ComboboxSelected>>", self.apply_filters)
        self.genre_filter.grid(row=0, column=1)
        
        tk.Label(filter_frame, text="Фильтр по году").grid(row=0, column=2)
        self.year_filter = ttk.Combobox(filter_frame, values=["Все"])
        self.year_filter.current(0)
        self.year_filter.bind("<<ComboboxSelected>>", self.apply_filters)
        self.year_filter.grid(row=0, column=3)
        
        # Таблица для отображения
        columns = ("Названеие", "Жанр", "Год", "Рейтинг")
        self.tree = ttk.Treeview(self.root, columns=columns, show='headings')
        for col in columns:
            self.tree.heading(col, text=col)
        self.tree.pack(padx=10, pady=10)
    
    def load_data(self):
        try:
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                self.movies = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.movies = []
    
    def save_data(self):
        with open(DATA_FILE, 'w', encoding='utf-8') as f:
            json.dump(self.movies, f, ensure_ascii=False, indent=4)
    
    def populate_table(self, filtered_list=None):
        # Очистить старое содержимое
        for item in self.tree.get_children():
            self.tree.delete(item)
        data_to_display = filtered_list if filtered_list is not None else self.movies
        for movie in data_to_display:
            self.tree.insert('', 'end', values=(movie['title'], movie['genre'], movie['year'], movie['rating']))
        
        # Обновление фильтров
        self.update_filters()
    
    def update_filters(self):
        genres = set(movie['genre'] for movie in self.movies)
        years = set(str(movie['year']) for movie in self.movies)
        self.genre_filter['values'] = ["Все"] + sorted(genres)
        self.year_filter['values'] = ["Все"] + sorted(years)
    
    def add_movie(self):
        title = self.title_entry.get().strip()
        genre = self.genre_entry.get().strip()
        year = self.year_entry.get().strip()
        rating = self.rating_entry.get().strip()
        
        # Проверка корректности
        if not title or not genre or not year or not rating:
            messagebox.showerror("Ошибка", "Заполните все поля")
            return
        
        if not year.isdigit():
            messagebox.showerror("Ошибка", "Год должен быть числом")
            return
        
        try:
            rating_value = float(rating)
            if not (0 <= rating_value <= 10):
                messagebox.showerror("Ошибка", "Рейтинг должен быть от 0 до 10")
                return
        except ValueError:
            messagebox.showerror("Ошибка", "Рейтинг должен быть числом")
            return
        
        new_movie = {
            'title': title,
            'genre': genre,
            'year': int(year),
            'rating': rating_value
        }
        self.movies.append(new_movie)
        self.save_data()
        self.populate_table()
        # Очистка полей
        self.title_entry.delete(0, tk.END)
        self.genre_entry.delete(0, tk.END)
        self.year_entry.delete(0, tk.END)
        self.rating_entry.delete(0, tk.END)
    
    def apply_filters(self, event=None):
        genre_filter = self.genre_filter.get()
        year_filter = self.year_filter.get()
        filtered = self.movies
        if genre_filter != "Все":
            filtered = [m for m in filtered if m['genre'] == genre_filter]
        if year_filter != "Все":
            filtered = [m for m in filtered if str(m['year']) == year_filter]
        self.populate_table(filtered)

# Запуск приложения
if __name__ == "__main__":
    root = tk.Tk()
    app = MovieLibraryApp(root)
    root.mainloop()
